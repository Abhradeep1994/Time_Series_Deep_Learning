    "### Sanity-check plot: reconstructed price on the most recent fold\n",
    "\n",
    "Point predictions in return-space are hard to eyeball, so for intuition we reconstruct price from\n",
    "predicted returns on the final (most recent) fold: `p_hat[t] = p[t-1] * exp(r_hat[t])`, using the\n",
    "seed-0 model runs. **This plot is for visual sanity-checking only — model selection and the\n",
    "conclusions above are based on the return-space metrics, not this chart**, since price-space plots\n",
    "of one-step-ahead forecasts on a near-random-walk series tend to look deceptively good regardless\n",
    "of actual skill (each point mostly just tracks yesterday's price).\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "23c84c54",
   "metadata": {},
   "outputs": [],
   "source": [
    "last_fold = splits[-1]\n",
    "tr_s, tr_e, te_s, te_e = last_fold\n",
    "prices_for_fold = df_time_series[\"adjusted_close\"].values[NSTEPS + 1:]  # align to Y_all indexing\n",
    "test_dates = df_time_series[\"dt\"].values[NSTEPS + 1:][te_s:te_e]\n",
    "prev_prices = prices_for_fold[te_s - 1:te_e - 1]\n",
    "true_prices = prices_for_fold[te_s:te_e]\n",
    "\n",
    "X_fit_raw, Y_fit_raw = X_all[tr_s:tr_e][:-max(1, int((tr_e-tr_s)*0.15))], Y_all[tr_s:tr_e][:-max(1, int((tr_e-tr_s)*0.15))]\n",
    "x_scaler = StandardScaler().fit(X_fit_raw)\n",
    "y_scaler = StandardScaler().fit(Y_fit_raw.reshape(-1, 1))\n",
    "X_test_scaled = x_scaler.transform(X_all[te_s:te_e])\n",
    "\n",
    "plt.figure(figsize=(16, 7))\n",
    "plt.plot(test_dates, true_prices, label=\"True price\", linewidth=2, color=\"black\")\n",
    "\n",
    "for model_name, ctor in MODEL_REGISTRY.items():\n",
    "    set_seed(0)\n",
    "    model = ctor()\n",
    "    n_val = max(1, int((tr_e - tr_s) * 0.15))\n",
    "    Xtr_t = shape_for_model(model_name, x_scaler.transform(X_all[tr_s:tr_e - n_val]))\n",
    "    ytr_t = torch.tensor(y_scaler.transform(Y_all[tr_s:tr_e - n_val].reshape(-1, 1)).flatten(), dtype=torch.float32)\n",
    "    Xval_t = shape_for_model(model_name, x_scaler.transform(X_all[tr_e - n_val:tr_e]))\n",
    "    yval_t = torch.tensor(y_scaler.transform(Y_all[tr_e - n_val:tr_e].reshape(-1, 1)).flatten(), dtype=torch.float32)\n",
    "    model = train_one(model, Xtr_t, ytr_t, Xval_t, yval_t)\n",
    "\n",
    "    with torch.no_grad():\n",
    "        pred_scaled = model(shape_for_model(model_name, X_test_scaled)).numpy()\n",
    "    pred_returns = y_scaler.inverse_transform(pred_scaled.reshape(-1, 1)).flatten()\n",
    "    reconstructed_price = prev_prices * np.exp(pred_returns)\n",
    "    plt.plot(test_dates, reconstructed_price, label=model_name, alpha=0.8)\n",
    "\n",
    "naive_zero_price = prev_prices  # exp(0) == 1\n",
    "plt.plot(test_dates, naive_zero_price, label=\"Naive-Zero\", linestyle=\":\", color=\"gray\")\n",
