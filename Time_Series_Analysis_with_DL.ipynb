   "source": [
    "## Data Preparation: Windowing and Walk-Forward Validation\n",
    "\n",
    "Every model gets the **same** sliding-window input: the previous `NSTEPS` log returns predicting\n",
    "the next one. This fixes the original bug where the RNN/LSTM/CNN/ResNet were trained on 1-step\n",
    "windows (and, for the RNN, on labels literally equal to the inputs).\n",
    "\n",
    "For validation, instead of one static train/test split, we use **walk-forward (rolling-origin)\n",
    "splits**: each fold trains on everything before a test window and evaluates on the window right\n",
    "after it, then the origin moves forward. This is standard practice for time series and gives a much\n",
    "more honest estimate of generalization than a single split.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "619c1ed8",
   "metadata": {},
   "outputs": [],
   "source": [
    "NSTEPS = 60  # lookback window, in trading days\n",
    "\n",
    "def create_sequences(series, nsteps):\n",
    "    X, Y = [], []\n",
    "    for i in range(nsteps, len(series)):\n",
    "        X.append(series[i - nsteps:i])\n",
    "        Y.append(series[i])\n",
    "    return np.array(X, dtype=np.float32), np.array(Y, dtype=np.float32)\n",
    "\n",
    "X_all, Y_all = create_sequences(log_returns, NSTEPS)\n",
    "print(\"X_all:\", X_all.shape, \" Y_all:\", Y_all.shape)\n",
    "\n",
    "def walk_forward_splits(n_samples, n_splits=3, test_size=200):\n",
    "    \"\"\"Returns (train_start, train_end, test_start, test_end) index tuples, oldest fold first.\"\"\"\n",
    "    splits = []\n",
    "    for i in range(n_splits):\n",
    "        test_end = n_samples - i * test_size\n",
    "        test_start = test_end - test_size\n",
    "        train_end = test_start\n",
    "        if train_end < test_size:\n",
    "            break\n",
    "        splits.append((0, train_end, test_start, test_end))\n",
    "    return list(reversed(splits))\n",
    "\n",
    "N_FOLDS = 3\n",
    "TEST_SIZE = 200  # trading days per test fold (~9-10 months)\n",
    "splits = walk_forward_splits(len(X_all), n_splits=N_FOLDS, test_size=TEST_SIZE)\n",
    "for i, s in enumerate(splits):\n",
    "    print(f\"Fold {i}: train=[{s[0]}:{s[1]}) ({s[1]-s[0]} pts)  test=[{s[2]}:{s[3]}) ({s[3]-s[2]} pts)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3703aff2",
   "metadata": {},
   "source": [
    "## Model Definitions\n",
    "\n",
    "All five architectures share the same interface: consume an `NSTEPS`-length window, output a\n",
    "single predicted return. Only the internal representation differs.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "eae87bef",
   "metadata": {},
   "outputs": [],
   "source": [
    "class FeedForwardNN(nn.Module):\n",
    "    \"\"\"Treats the window as a flat feature vector.\"\"\"\n",
    "    def __init__(self, input_size, hidden_size, output_size=1):\n",
    "        super().__init__()\n",
    "        self.fc1 = nn.Linear(input_size, hidden_size)\n",
    "        self.fc2 = nn.Linear(hidden_size, output_size)\n",
    "\n",
    "    def forward(self, x):\n",
    "        x = torch.relu(self.fc1(x))\n",
    "        return self.fc2(x).squeeze(-1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "49258aa7",
   "metadata": {},
   "outputs": [],
   "source": [
    "class RNNModel(nn.Module):\n",
    "    \"\"\"Vanilla RNN over the window, prediction from the final hidden state.\"\"\"\n",
    "    def __init__(self, hidden_size, num_layers=1, output_size=1):\n",
    "        super().__init__()\n",
    "        self.rnn = nn.RNN(1, hidden_size, num_layers, batch_first=True)\n",
    "        self.fc = nn.Linear(hidden_size, output_size)\n",
    "\n",
    "    def forward(self, x):\n",
    "        out, _ = self.rnn(x)\n",
    "        return self.fc(out[:, -1, :]).squeeze(-1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e116e024",
   "metadata": {},
   "outputs": [],
   "source": [
    "class LSTMModel(nn.Module):\n",
    "    \"\"\"LSTM over the window; the gated memory cell should help with longer-range dependence\n",
    "    than the vanilla RNN.\"\"\"\n",
    "    def __init__(self, hidden_size, num_layers=1, output_size=1):\n",
    "        super().__init__()\n",
    "        self.lstm = nn.LSTM(1, hidden_size, num_layers, batch_first=True)\n",
    "        self.fc = nn.Linear(hidden_size, output_size)\n",
    "\n",
    "    def forward(self, x):\n",
    "        out, _ = self.lstm(x)\n",
    "        return self.fc(out[:, -1, :]).squeeze(-1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9daa07a0",
   "metadata": {},
   "outputs": [],
   "source": [
    "class CNNModel(nn.Module):\n",
    "    \"\"\"1D convolution over the window followed by global average pooling, so the same model\n",
    "    works regardless of NSTEPS without a hardcoded flatten size.\"\"\"\n",
    "    def __init__(self, channels=32, output_size=1):\n",
    "        super().__init__()\n",
    "        self.conv1 = nn.Conv1d(1, channels, kernel_size=3, padding=1)\n",
    "        self.relu = nn.ReLU()\n",
    "        self.fc = nn.Linear(channels, output_size)\n",
    "\n",
    "    def forward(self, x):\n",
    "        out = self.relu(self.conv1(x))\n",
    "        out = out.mean(dim=2)  # global average pool over the time axis\n",
    "        return self.fc(out).squeeze(-1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7e7d3c2e",
   "metadata": {},
   "outputs": [],
   "source": [
    "class ResidualBlock(nn.Module):\n",
    "    def __init__(self, channels):\n",
    "        super().__init__()\n",
    "        self.conv1 = nn.Conv1d(channels, channels, kernel_size=3, padding=1)\n",
    "        self.relu = nn.ReLU()\n",
    "        self.conv2 = nn.Conv1d(channels, channels, kernel_size=3, padding=1)\n",
    "\n",
    "    def forward(self, x):\n",
    "        residual = x\n",
    "        out = self.relu(self.conv1(x))\n",
    "        out = self.conv2(out)\n",
    "        return self.relu(out + residual)\n",
    "\n",
    "\n",
    "class ResNetModel(nn.Module):\n",
    "    def __init__(self, num_blocks=3, channels=32, output_size=1):\n",
    "        super().__init__()\n",
    "        self.conv1 = nn.Conv1d(1, channels, kernel_size=3, padding=1)\n",
    "        self.relu = nn.ReLU()\n",
    "        self.blocks = nn.Sequential(*[ResidualBlock(channels) for _ in range(num_blocks)])\n",
    "        self.fc = nn.Linear(channels, output_size)\n",
    "\n",
    "    def forward(self, x):\n",
    "        out = self.relu(self.conv1(x))\n",
    "        out = self.blocks(out)\n",
    "        out = out.mean(dim=2)\n",
    "        return self.fc(out).squeeze(-1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cb0705b4",
   "metadata": {},
   "outputs": [],
   "source": [
    "def shape_for_model(model_name, X):\n",
    "    \"\"\"Same windowed data, reshaped to what each architecture expects.\"\"\"\n",
    "    if model_name == \"FeedForward\":\n",
    "        return torch.tensor(X, dtype=torch.float32)                      # (batch, nsteps)\n",
    "    if model_name in (\"RNN\", \"LSTM\"):\n",
    "        return torch.tensor(X, dtype=torch.float32).unsqueeze(-1)        # (batch, nsteps, 1)\n",
    "    if model_name in (\"CNN\", \"ResNet\"):\n",
    "        return torch.tensor(X, dtype=torch.float32).unsqueeze(1)         # (batch, 1, nsteps)\n",
    "    raise ValueError(model_name)\n",
    "\n",
    "MODEL_REGISTRY = {\n",
    "    \"FeedForward\": lambda: FeedForwardNN(NSTEPS, 32),\n",
    "    \"RNN\":         lambda: RNNModel(32),\n",
    "    \"LSTM\":        lambda: LSTMModel(32),\n",
    "    \"CNN\":         lambda: CNNModel(32),\n",
    "    \"ResNet\":      lambda: ResNetModel(num_blocks=3, channels=32),\n",
    "}"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1d6a8366",
   "metadata": {},
   "source": [
    "## Training: Early Stopping on a Held-Out Validation Slice\n",
    "\n",
    "Each fold's training data is further split into a fit set and a validation tail (last 15%,\n",
    "still strictly before the test window). We train with early stopping on validation loss instead of\n",
    "a fixed epoch count for every architecture — a ResNet and a 2-layer FFN don't converge at the same\n",
    "rate, so forcing identical epochs/LR on both (as in the original notebook) biases the comparison.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cac110ec",
   "metadata": {},
   "outputs": [],
   "source": [
    "def train_one(model, X_train, y_train, X_val, y_val, max_epochs=200, patience=15, lr=0.005):\n",
    "    optimizer = optim.Adam(model.parameters(), lr=lr)\n",
    "    criterion = nn.MSELoss()\n",
    "    best_val = float(\"inf\")\n",
    "    best_state = None\n",
    "    bad_epochs = 0\n",
    "\n",
    "    for epoch in range(max_epochs):\n",
    "        model.train()\n",
    "        optimizer.zero_grad()\n",
    "        loss = criterion(model(X_train), y_train)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "        model.eval()\n",
    "        with torch.no_grad():\n",
    "            val_loss = criterion(model(X_val), y_val).item()\n",
    "\n",
    "        if val_loss < best_val - 1e-6:\n",
    "            best_val = val_loss\n",
    "            best_state = {k: v.clone() for k, v in model.state_dict().items()}\n",
    "            bad_epochs = 0\n",
    "        else:\n",
    "            bad_epochs += 1\n",
    "            if bad_epochs >= patience:\n",
    "                break\n",
    "\n",
    "    if best_state is not None:\n",
    "        model.load_state_dict(best_state)\n",
    "    return model\n",
    "\n",
    "def directional_accuracy(y_true, y_pred):\n",
    "    \"\"\"Fraction of test points where the predicted move has the same sign as the actual move.\"\"\"\n",
    "    return float(np.mean(np.sign(y_true) == np.sign(y_pred)))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "91dc259e",
   "metadata": {},
   "source": [
    "## Experiment: Walk-Forward × Multiple Seeds × Baselines + Models\n",
    "\n",
    "Two naive baselines, evaluated the same way as the learned models:\n",
    "\n",
    "- **Naive-Zero** — predict a return of 0 (classic random-walk baseline; this is what raw-price\n",
    "  RMSE was implicitly competing against, unbeknownst to the original notebook).\n",
    "- **Naive-Persistence** — predict tomorrow's return equals the most recently observed return\n",
    "  (a simple momentum baseline; useful for direction-of-move comparisons, since Naive-Zero has no\n",
    "  directional signal by construction).\n",
    "\n",
    "Scaling is fit **per fold, on the training portion only** — never on validation or test data, and\n",
    "never on the full series up front.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e7062da2",
   "metadata": {},
   "outputs": [],
   "source": [
    "results = []\n",
    "\n",
    "for fold_id, (tr_s, tr_e, te_s, te_e) in enumerate(splits):\n",
    "    X_train_raw, Y_train_raw = X_all[tr_s:tr_e], Y_all[tr_s:tr_e]\n",
    "    X_test_raw,  Y_test_raw  = X_all[te_s:te_e], Y_all[te_s:te_e]\n",
    "\n",
    "    # held-out validation tail for early stopping, carved from the train fold only\n",
    "    n_val = max(1, int(len(X_train_raw) * 0.15))\n",
    "    X_fit_raw, Y_fit_raw = X_train_raw[:-n_val], Y_train_raw[:-n_val]\n",
    "    X_val_raw, Y_val_raw = X_train_raw[-n_val:], Y_train_raw[-n_val:]\n",
    "\n",
    "    # scale using train-fit statistics only (no leakage from val/test)\n",
    "    x_scaler = StandardScaler()\n",
    "    X_fit = x_scaler.fit_transform(X_fit_raw)\n",
    "    X_val = x_scaler.transform(X_val_raw)\n",
    "    X_test = x_scaler.transform(X_test_raw)\n",
    "\n",
    "    y_scaler = StandardScaler()\n",
    "    Y_fit = y_scaler.fit_transform(Y_fit_raw.reshape(-1, 1)).flatten()\n",
    "    Y_val = y_scaler.transform(Y_val_raw.reshape(-1, 1)).flatten()\n",
    "    # Y_test_raw is kept in original return units; predictions are inverse-transformed before scoring\n",
    "\n",
    "    # --- baselines ---\n",
    "    for name, preds in [\n",
    "        (\"Naive-Zero\", np.zeros_like(Y_test_raw)),\n",
    "        (\"Naive-Persistence\", X_test_raw[:, -1]),\n",
    "    ]:\n",
    "        mse = float(np.mean((Y_test_raw - preds) ** 2))\n",
    "        mae = float(np.mean(np.abs(Y_test_raw - preds)))\n",
    "        da = directional_accuracy(Y_test_raw, preds)\n",
    "        results.append(dict(fold=fold_id, model=name, seed=-1, mse=mse, rmse=mse ** 0.5, mae=mae, dir_acc=da))\n",
    "\n",
    "    # --- learned models, multiple seeds each ---\n",
    "    for model_name, ctor in MODEL_REGISTRY.items():\n",
    "        for seed in SEEDS:\n",
    "            set_seed(seed)\n",
    "            model = ctor()\n",
    "\n",
    "            Xtr_t = shape_for_model(model_name, X_fit)\n",
    "            ytr_t = torch.tensor(Y_fit, dtype=torch.float32)\n",
    "            Xval_t = shape_for_model(model_name, X_val)\n",
    "            yval_t = torch.tensor(Y_val, dtype=torch.float32)\n",
    "\n",
    "            model = train_one(model, Xtr_t, ytr_t, Xval_t, yval_t)\n",
    "\n",
    "            Xte_t = shape_for_model(model_name, X_test)\n",
    "            model.eval()\n",
    "            with torch.no_grad():\n",
    "                pred_scaled = model(Xte_t).numpy()\n",
    "            preds = y_scaler.inverse_transform(pred_scaled.reshape(-1, 1)).flatten()\n",
    "\n",
    "            mse = float(np.mean((Y_test_raw - preds) ** 2))\n",
    "            mae = float(np.mean(np.abs(Y_test_raw - preds)))\n",
    "            da = directional_accuracy(Y_test_raw, preds)\n",
    "            results.append(dict(fold=fold_id, model=model_name, seed=seed, mse=mse, rmse=mse ** 0.5,\n",
    "                                 mae=mae, dir_acc=da))\n",
    "\n",
    "    print(f\"Fold {fold_id} done.\")\n",
    "\n",
    "results_df = pd.DataFrame(results)\n",
    "results_df.head()"
   ]
